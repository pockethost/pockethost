# Cloudflare static assets headers (copied into build/ by SvelteKit).
# SvelteKit's hashed files never change once built, so browsers can keep them for a year.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# the CLI install script (curl -fsSL https://pockethost.io/install.sh | sh): plain text, so a browser shows it
/install.sh
  Content-Type: text/plain; charset=utf-8
